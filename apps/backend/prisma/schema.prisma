generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  CREATED
  PAID
  QUEUED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

model Order {
  id          String      @id @default(cuid())
  publicToken String      @unique
  status      OrderStatus @default(CREATED)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}
